+/// The ABI flags of the build that runs purba, in the order of `sys.abiflags`:
+/// `t` for a free-threaded build, and `d` for a debug build. A test can change
+/// neither source.
+fn abi_flags() -> String {
+    // https://github.com/python/cpython/blob/v3.15.2/Python/getversion.c#L17-L23
+    let free_threaded = Python::version_str().contains(" free-threading build ");
+    let debug = purba_execution::debug_build();
+    format!(
+        "{}{}",
+        if free_threaded { "t" } else { "" },
+        if debug { "d" } else { "" }
+    )
+}
