+/// The ABI flags of the build that runs purba, in the order of `sys.abiflags`:
+/// `t` for a free-threaded build, and `d` for a debug build. A test can change
+/// neither source.
+fn abi_flags() -> String {
+    let free_threaded = cfg!(Py_GIL_DISABLED);
+    // Only a debug build exports this function:
+    // https://github.com/python/cpython/blob/v3.15.0/Misc/stable_abi.toml#L2267-L2274
+    // SAFETY: the name is a C string, and `dlsym` only reads it.
+    let debug =
+        !unsafe { libc::dlsym(libc::RTLD_DEFAULT, c"_Py_NegativeRefcount".as_ptr()) }.is_null();
+    format!(
+        "{}{}",
+        if free_threaded { "t" } else { "" },
+        if debug { "d" } else { "" }
+    )
+}
