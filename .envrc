# watch_file comes first so a broken devenv.nix still triggers a reload: direnv
# caches a failed eval and re-runs only when a watched file changes.
# https://direnv.net/man/direnv-stdlib.1.html
watch_file devenv.nix devenv.lock devenv.yaml

# `devenv print-dev-env` rather than `source_url` plus `use devenv`, which pins
# a devenv revision and sha256 in every repo that adopts it. This fetches
# nothing, and it is how a tool loads the environment without opening a
# subshell: `direnv exec . <cmd>`.
# https://devenv.sh/integrations/direnv/
eval "$(devenv print-dev-env)"
